# FileFlow - Railway Environment Configuration
# ============================================================
# Set these as environment variables in Railway service settings
# ============================================================

# Server Configuration
PORT=8680
NODE_ENV=production

# ============================================================
# SUPABASE CLOUD SETUP (Required)
# ============================================================
# 1. Go to https://supabase.com and create a project (or use existing)
# 2. Run the migrations in migrations/ folder against your Supabase DB
# 3. Go to Project Settings > API
# 4. Copy the values below:

# Project URL (Settings > API > Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role Key (Settings > API > service_role key) - KEEP SECRET!
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# BUILD ARGS (Set in Railway Build Settings)
# ============================================================
# These are needed during Docker build for the Vite client:

# VITE_API_URL=/api
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ============================================================
# SECURITY
# ============================================================

# JWT Secret for auth tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=generate-a-strong-32-char-secret-here
