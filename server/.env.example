# FileFlow Server - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8680
NODE_ENV=development

# Supabase Configuration
# For local development with local Supabase:
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_KEY=your-service-role-key

# For production with Supabase Cloud:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# JWT Secret for user sessions
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-in-production

# PDFFlow Integration (Document Processing)
# URL to PDFFlow service for OCR, translation, extraction
PDFFLOW_URL=http://localhost:8000
PDFFLOW_API_KEY=
