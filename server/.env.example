# FileFlow Server - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8680
NODE_ENV=development

# Supabase Configuration
# For local development with local Supabase:
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_KEY=your-service-role-key

# For production with Supabase Cloud:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key

# JWT Secret for user sessions
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-in-production

# PDFFlow Integration (Document Processing)
# URL to PDFFlow service for OCR, translation, extraction
PDFFLOW_URL=http://localhost:8000
PDFFLOW_API_KEY=

# Public URL Configuration (important for Railway/production deployments)
# PUBLIC_URL: The URL of this server (used in API responses for download links)
# CLIENT_URL: The URL of the frontend client (used in share links, e-signature links, etc.)
# If not set, defaults to http://localhost:PORT and http://localhost:5175
PUBLIC_URL=https://your-server.railway.app
CLIENT_URL=https://your-client.railway.app

# SMTP Email Configuration
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
# For other providers: Use your SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=FileFlow <noreply@fileflow.local>
